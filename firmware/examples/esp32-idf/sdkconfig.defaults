CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# The bootloader reverts to the previous slot if a new firmware never marks itself valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# A bigger TCP receive window for OTA downloads (#4): with the default 4 segments, a single
# lost packet can't trigger a fast retransmit, so the server waits for its retransmission
# timer, which doubles at each loss; on a weak Wi-Fi link the transfer stalls for seconds.
# The mailboxes must hold a window's worth of segments, or lwIP drops them.
CONFIG_LWIP_TCP_WND_DEFAULT=23040
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_ESP_WIFI_RX_BA_WIN=16
