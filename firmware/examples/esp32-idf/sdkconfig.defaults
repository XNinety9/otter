# Settings Otter needs (or benefits from). Copy them into your project's sdkconfig.defaults.
# After changing this file, delete the generated sdkconfig.<env> so they apply.

# [ADAPT] Your board's flash size (4 MB fits the partitions below; see partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# The bootloader reverts to the previous slot if a new firmware never marks itself valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# A bigger TCP receive window for OTA downloads (#4): with the default 4 segments, a single
# lost packet can't trigger a fast retransmit, so the server waits for its retransmission
# timer, which doubles at each loss; on a weak Wi-Fi link the transfer stalls for seconds.
# The mailboxes must hold a window's worth of segments, or lwIP drops them.
CONFIG_LWIP_TCP_WND_DEFAULT=23040
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_ESP_WIFI_RX_BA_WIN=16

# Crash reports (#24): after a crash the core dump is kept in the "coredump" partition, and the
# agent sends its summary to Otter at the next check-in.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
