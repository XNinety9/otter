# Added to sdkconfig.defaults by ESP-IDF when building for an ESP32-S3.
# PSRAM: octal, as in the S3 modules and chips with 8 MB or more (N8R8, N16R8, ESP32-S3R8).
# For quad PSRAM (N4R2, N8R2…), use CONFIG_SPIRAM_MODE_QUAD instead. A board without PSRAM
# still boots: the firmware carries on without it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
